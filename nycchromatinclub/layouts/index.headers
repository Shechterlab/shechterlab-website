{{- /*
  Local override of the Netlify `_headers` generator vendored at
  src/layouts/index.headers in the
  github.com/HugoBlox/kit/modules/integrations/netlify module.

  Why this exists: the vendored template's whitespace chomping around
  the X-Frame-Options branch swallowed the newline after the `/*` path
  line, so the generated file began

      /*X-XSS-Protection: 1; mode=block
        X-Content-Type-Options: nosniff
        ...

  Netlify treats any line that does not start with whitespace as a
  path, so it read `/*X-XSS-Protection: 1; mode=block` as the path —
  which matches no URL — and every indented header under it was
  therefore applied to nothing. The site was shipping a _headers file
  that set no headers at all, and X-Frame-Options was dropped entirely.

  Rebuilt to assemble the header lines into a slice and join them, so
  the layout cannot collapse again if a branch is added later.

  Also dropped X-XSS-Protection. The header is deprecated, ignored by
  every current browser, and its legacy filter could itself introduce
  vulnerabilities; the modern advice is to omit it and rely on CSP.

  Values come from site.Params.hugoblox.security in params.yaml.
  If Hugo Blox changes the vendored template upstream, this override
  will NOT pick up those changes automatically.
*/ -}}
{{- $csp_policy := site.Params.hugoblox.security.csp.policy | default "" -}}
{{- $csp_report_only := site.Params.hugoblox.security.csp.report_only | default false -}}
{{- $frame_options := site.Params.hugoblox.security.frame_options | default "deny" -}}
{{- $default_perms := "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" -}}
{{- $permissions_policy := site.Params.hugoblox.security.permissions_policy | default $default_perms -}}
{{- $lines := slice -}}
{{- if ne $frame_options "allow" -}}
  {{- $lines = $lines | append (printf "  X-Frame-Options: %s" (cond (eq $frame_options "sameorigin") "SAMEORIGIN" "DENY")) -}}
{{- end -}}
{{- $lines = $lines | append "  X-Content-Type-Options: nosniff" -}}
{{- $lines = $lines | append "  Strict-Transport-Security: max-age=31536000; includeSubDomains" -}}
{{- $lines = $lines | append "  Referrer-Policy: strict-origin-when-cross-origin" -}}
{{- with $csp_policy -}}
  {{- $name := cond $csp_report_only "Content-Security-Policy-Report-Only" "Content-Security-Policy" -}}
  {{- $lines = $lines | append (printf "  %s: %s" $name (replaceRE `\s\s+` " " (trim . " "))) -}}
{{- end -}}
{{- with $permissions_policy -}}
  {{- $lines = $lines | append (printf "  Permissions-Policy: %s" (replaceRE `\s\s+` " " (trim . " "))) -}}
{{- end -}}
# Netlify headers
# Generated by layouts/index.headers — edit values in config/_default/params.yaml
# under hugoblox.security, not here.
/*
{{ delimit $lines "\n" }}
/index.webmanifest
  Content-Type: application/manifest+json
/index.xml
  Content-Type: application/rss+xml
