{{- /*
  Local override of Hugo Blox Kit's sitemap.xml (vendored at that same path).

  Why: Hugo generates a page per taxonomy term, and the generated sitemap was
  348 URLs of which 240 were /authors/ pages — one for every name in every
  paper's front matter, mostly external co-authors whose page holds a name and
  a single citation. Add 29 /tags/ terms and 4 /publication_types/. Nearly
  three quarters of what we handed Google was thin.

  This lists real pages only: no /tags/, no /publication_types/, and of the
  author pages just David's, which is a genuine profile with his full
  publication list. The other author and tag pages still exist and still
  resolve — bylines link to lab members' pages — they are simply neither
  advertised here nor crawled (layouts/robots.txt disallows the same paths).

  Everything else is upstream's template unchanged, including the private-page
  filter and the translation links.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{/* Check that page is built (has a URL) and is not private. */}}
  {{ range where (where .Data.Pages "Permalink" "!=" "") "Params.private" "ne" true }}
  {{- $skip := false -}}
  {{- if in (slice "tags" "publication_types") .Type }}{{ $skip = true }}{{ end -}}
  {{- if eq .Type "authors" -}}
    {{- if ne .RelPermalink "/authors/david-shechter/" }}{{ $skip = true }}{{ end -}}
  {{- end -}}
  {{- if not $skip }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}<lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
    {{- with .Sitemap.ChangeFreq }}<changefreq>{{ . }}</changefreq>{{ end }}
    {{- if ge .Sitemap.Priority 0.0 }}<priority>{{ .Sitemap.Priority }}</priority>{{ end }}
    {{- if .IsTranslated -}}

    {{- range .Translations -}}
    <xhtml:link
      rel="alternate"
      hreflang="{{ .Language.Lang }}"
      href="{{ .Permalink }}"
    />
    {{- end -}}

    <xhtml:link
      rel="alternate"
      hreflang="{{ .Language.Lang }}"
      href="{{ .Permalink }}"
    />

    {{- end -}}
  </url>
  {{- end -}}
  {{- end -}}
</urlset>
